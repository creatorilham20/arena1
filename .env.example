# Salin file ini menjadi .env.local lalu isi nilai asli (jangan pernah commit .env.local)

# Koneksi PostgreSQL langsung ke Supabase (Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://postgres:[DB-PASSWORD]@db.YOURPROJECTREF.supabase.co:5432/postgres

# Supabase REST (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOURPROJECTREF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...