# Salin file ini menjadi .env.local lalu isi nilai asli (jangan pernah commit .env.local)

# Koneksi PostgreSQL Supabase: gunakan Session pooler (IPv4)
DATABASE_URL=postgresql://postgres.YOURPROJECTREF:[DB-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOURPROJECTREF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...